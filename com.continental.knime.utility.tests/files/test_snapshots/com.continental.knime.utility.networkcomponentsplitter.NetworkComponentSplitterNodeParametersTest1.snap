      "scope" : "#/properties/model/properties/inputColumn2",
      "options" : {
        "format" : "dropDown"
      },
      "providedOptions" : [ "possibleValues" ],
      "rule" : {
        "effect" : "ENABLE",
        "condition" : {
          "schema" : { }
        }
      }
    }, {
      "label" : "Missing Value Handling",
      "type" : "Section",
      "elements" : [ {
        "type" : "Control",
        "scope" : "#/properties/model/properties/missingValueAllowedAsOwnNode",
        "options" : {
          "format" : "checkbox"
        }
      } ]
    }, {
      "label" : "Output Column Names",
      "type" : "Section",
      "elements" : [ {
        "type" : "Control",
        "scope" : "#/properties/model/properties/outputColumnNameNode",
        "options" : {
          "validation" : {
            "pattern" : {
              "errorMessage" : "The field cannot be blank (it must contain at least one non-whitespace character).",
              "parameters" : {
                "pattern" : ".*\\S.*"
              }
            }
          }
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/outputColumnNameCluster",
