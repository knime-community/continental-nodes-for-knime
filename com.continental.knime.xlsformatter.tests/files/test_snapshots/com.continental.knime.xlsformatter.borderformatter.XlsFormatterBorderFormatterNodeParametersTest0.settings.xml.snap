<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.knime.org/2008/09/XMLConfig" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.knime.org/2008/09/XMLConfig http://www.knime.org/XMLConfig_2008_09.xsd" key="test">
    <entry key="performTagValiation" type="xboolean" value="false"/>
    <entry key="AllTags" type="xboolean" value="false"/>
    <entry key="Tag" type="xstring" value="header"/>
    <entry key="BorderStyle" type="xstring" value="normal"/>
    <entry key="ChangeBorderColor" type="xboolean" value="false"/>
    <config key="BorderColor">
        <entry key="Red" type="xint" value="0"/>
        <entry key="Green" type="xint" value="0"/>
        <entry key="Blue" type="xint" value="0"/>
        <entry key="Alpha" type="xint" value="255"/>
    </config>
    <entry key="BorderTop" type="xboolean" value="true"/>
    <entry key="BorderLeft" type="xboolean" value="false"/>
    <entry key="BorderRight" type="xboolean" value="false"/>
    <entry key="BorderBottom" type="xboolean" value="false"/>
    <entry key="BorderInnerVertical" type="xboolean" value="false"/>
    <entry key="BorderInnerHorizontal" type="xboolean" value="false"/>
</config>
