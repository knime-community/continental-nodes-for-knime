<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.knime.org/2008/09/XMLConfig" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.knime.org/2008/09/XMLConfig http://www.knime.org/XMLConfig_2008_09.xsd" key="test">
    <entry key="performTagValiation" type="xboolean" value="false"/>
    <entry key="Tag" type="xstring" value="header"/>
    <entry key="HorizontalAlignment" type="xstring" value="left"/>
    <entry key="VerticalAlignment" type="xstring" value="unmodified"/>
    <entry key="TextRotation" type="xstring" value="unmodified"/>
    <entry key="WordWrap" type="xboolean" value="false"/>
    <entry key="CellStyle" type="xstring" value="unmodified"/>
    <entry key="TextFormat" type="xstring" value=""/>
    <entry key="TextPresets" type="xstring" value="[select preset text format]"/>
</config>
