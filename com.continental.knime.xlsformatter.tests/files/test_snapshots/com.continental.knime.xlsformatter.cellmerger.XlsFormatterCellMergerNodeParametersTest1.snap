{
  "data" : {
    "model" : {
      "performTagValiation" : false,
      "allTags" : false,
      "tag" : "header"
    }
  },
  "schema" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "allTags" : {
            "type" : "boolean",
            "title" : "Applies to all tags",
            "description" : "Instead of specifying a single tag, the Cell Merger is applied repetitively to all distinct tags found in\nthe control table. Note that in this case, no comma-separated tag list splitting is applied but the full\ncell content qualifies as a tag. This option eases definition of adjacent merge ranges based on the original\n data table's values.\n",
            "default" : false
          },
          "performTagValiation" : {
            "type" : "boolean",
            "default" : true
          },
          "tag" : {
            "type" : "string",
            "title" : "Applies to tag (single tag only)",
            "description" : "Tag in your XLS Control Table that defines the merge range(s).",
            "default" : "header"
          }
        }
      }
    }
  },
  "ui_schema" : {
    "elements" : [ {
      "type" : "Control",
      "scope" : "#/properties/model/properties/allTags",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/tag",
      "providedOptions" : [ "validation.pattern" ],
      "rule" : {
        "effect" : "HIDE",
        "condition" : {
          "scope" : "#/properties/model/properties/allTags",
          "schema" : {
            "const" : true
          }
        }
      }
    } ]
  },
  "persist" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "performTagValiation" : {
            "deprecatedConfigKeys" : [ {
              "deprecated" : [ ]
            } ]
          },
          "allTags" : {
            "configKey" : "AllTags"
          },
          "tag" : {
            "configKey" : "Tag(s)"
          }
        }
      }
    }
  },
  "initialUpdates" : [ {
    "scope" : "#/properties/model/properties/performTagValiation",
    "values" : [ {
      "indices" : [ ],
      "value" : true
    } ]
  } ],
  "globalUpdates" : [ {
    "trigger" : {
      "id" : "after-open-dialog"
    },
    "triggerInitially" : true,
    "dependencies" : [ "#/properties/model/properties/tag" ]
  }, {
    "trigger" : {
      "scope" : "#/properties/model/properties/tag"
    },
    "dependencies" : [ "#/properties/model/properties/tag" ]
  } ]
}