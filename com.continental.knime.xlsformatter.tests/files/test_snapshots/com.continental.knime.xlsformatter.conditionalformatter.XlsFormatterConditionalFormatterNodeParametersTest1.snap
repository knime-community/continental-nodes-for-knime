                "parameters" : {
                  "pattern" : "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                }
              }
            }
          },
          "rule" : {
            "effect" : "ENABLE",
            "condition" : {
              "scope" : "#/properties/model/properties/midScalePointActive",
              "schema" : {
                "const" : true
              }
