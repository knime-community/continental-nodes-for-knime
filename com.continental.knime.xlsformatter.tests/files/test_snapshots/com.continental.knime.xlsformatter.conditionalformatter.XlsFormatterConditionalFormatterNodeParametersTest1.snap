            "validation" : { }
          },
          "providedOptions" : [ "validation.max" ]
        }, {
          "type" : "Control",
          "scope" : "#/properties/model/properties/minColor/properties/hexColorWithAlpha",
          "options" : {
            "validation" : {
              "pattern" : {
                "errorMessage" : "Invalid color format. Please provide a hex color in the format #RRGGBB or #RRGGBBAA.",
                "parameters" : {
                  "pattern" : "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                }
              }
            }
          }
        } ]
      }, {
        "type" : "HorizontalLayout",
