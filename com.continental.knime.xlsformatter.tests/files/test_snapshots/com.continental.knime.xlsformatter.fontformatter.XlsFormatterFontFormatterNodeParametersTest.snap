{
  "data" : {
    "model" : {
      "performTagValiation" : true,
      "tag" : "header",
      "bold" : false,
      "italic" : false,
      "underline" : false,
      "changeFontSize" : false,
      "size" : 12,
      "changeColor" : false,
      "fontColor" : {
        "hexColorWithAlpha" : "#000000FF"
      }
    }
  },
  "schema" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "bold" : {
            "type" : "boolean",
            "title" : "Bold",
            "description" : "Set your font to bold.",
            "default" : false
          },
          "changeColor" : {
            "type" : "boolean",
            "title" : "Change color?",
            "description" : "If you want to change the font color you can enable it here.\n",
            "default" : false
          },
          "changeFontSize" : {
            "type" : "boolean",
            "title" : "Change font size?",
            "description" : "If you want to change the font size you can enable it here.\n",
            "default" : false
          },
          "fontColor" : {
            "type" : "object",
            "properties" : {
              "hexColorWithAlpha" : {
                "type" : "string",
                "title" : "Color",
                "description" : "Choose a color in hex format with optional alpha channel.",
                "default" : "#000000FF"
              }
            },
            "default" : {
              "hexColorWithAlpha" : "#000000FF"
            }
          },
          "italic" : {
            "type" : "boolean",
            "title" : "Italic",
            "description" : "Set your font to italic.",
            "default" : false
          },
          "performTagValiation" : {
            "type" : "boolean",
            "default" : true
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "Font size",
            "description" : "Select the size of your font.",
            "default" : 12
          },
          "tag" : {
            "type" : "string",
            "title" : "Applies to tag (single tag only)",
            "description" : "Tag in your input table for which the formatting of this node should be applied to.\n",
            "default" : "header"
          },
          "underline" : {
            "type" : "boolean",
            "title" : "Underline",
            "description" : "Set your font to underline.",
            "default" : false
          }
        }
      }
    }
  },
  "ui_schema" : {
    "elements" : [ {
      "type" : "Control",
      "scope" : "#/properties/model/properties/tag",
      "providedOptions" : [ "validation.pattern" ]
    }, {
      "label" : "Font Specification",
      "type" : "Section",
      "elements" : [ {
        "type" : "Control",
        "scope" : "#/properties/model/properties/bold",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/italic",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/underline",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/changeFontSize",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/size",
        "options" : {
          "validation" : {
            "max" : {
              "errorMessage" : "The value must not exceed 2147483647.",
              "parameters" : {
                "isExclusive" : false,
                "max" : 2.147483647E9
              }
            },
            "min" : {
              "errorMessage" : "The value must be at least 1.",
              "parameters" : {
                "isExclusive" : false,
                "min" : 1.0
              }
            }
          }
        },
        "rule" : {
          "effect" : "ENABLE",
          "condition" : {
            "scope" : "#/properties/model/properties/changeFontSize",
            "schema" : {
              "const" : true
            }
          }
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/changeColor",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/fontColor/properties/hexColorWithAlpha",
        "options" : {
          "validation" : {
            "pattern" : {
              "errorMessage" : "Invalid color format. Please provide a hex color in the format #RRGGBB or #RRGGBBAA.",
              "parameters" : {
                "pattern" : "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              }
            }
          }
        },
        "rule" : {
          "effect" : "ENABLE",
          "condition" : {
            "scope" : "#/properties/model/properties/changeColor",
            "schema" : {
              "const" : true
            }
          }
        }
      } ]
    } ]
  },
  "persist" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "performTagValiation" : {
            "deprecatedConfigKeys" : [ {
              "deprecated" : [ ]
            } ]
          },
          "tag" : {
            "configKey" : "Tag"
          },
          "bold" : {
            "configKey" : "Bold"
          },
          "italic" : {
            "configKey" : "Italic"
          },
          "underline" : {
            "configKey" : "Underline"
          },
          "changeFontSize" : {
            "configKey" : "ChangeSize"
          },
          "size" : {
            "configKey" : "Size"
          },
          "changeColor" : {
            "configKey" : "ChangeColor"
          },
          "fontColor" : {
            "type" : "object",
            "properties" : {
              "hexColorWithAlpha" : {
                "configPaths" : [ [ "Red" ], [ "Green" ], [ "Blue" ], [ "Alpha" ] ]
              }
            },
            "configKey" : "FontColor"
          }
        }
      }
    }
  },
  "initialUpdates" : [ {
    "scope" : "#/properties/model/properties/performTagValiation",
    "values" : [ {
      "indices" : [ ],
      "value" : true
    } ]
  } ],
  "globalUpdates" : [ {
    "trigger" : {
      "id" : "after-open-dialog"
    },
    "triggerInitially" : true,
    "dependencies" : [ "#/properties/model/properties/tag" ]
  }, {
    "trigger" : {
      "scope" : "#/properties/model/properties/tag"
    },
    "dependencies" : [ "#/properties/model/properties/tag" ]
  } ]
}